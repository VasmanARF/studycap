# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# Flask
SECRET_KEY=change-me-to-a-long-random-string

# Stripe (use test keys for local development)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# MySQL database
# Local TCP connection:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=studycap
DB_USER=studycap-user
DB_PASSWORD=your-db-password
# On Google App Engine + Cloud SQL, use a Unix socket instead:
# DB_HOST=/cloudsql/<project-id>:<region>:<instance-name>
# INSTANCE_CONNECTION_NAME=<project-id>:<region>:<instance-name>

# OpenAI (lecture summaries, quizzes and chat)
OPENAI_API_KEY=sk-xxx

# YouTube Data API v3 ("Explained on YouTube" feature, optional)
YOUTUBE_API_KEY=your-youtube-api-key

# PostHog product analytics (optional; leave empty to disable)
POSTHOG_API_KEY=

# Admin endpoints (/admin/referrals, /api/admin/qr-stats) and the feedback dashboard
ADMIN_KEY=change-me
FEEDBACK_ADMIN_PASSWORD=change-me
